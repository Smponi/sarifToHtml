<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }}</title>
  <style>
    :root {
      color-scheme: dark;
      --ink: #0b0f12;
      --panel: #111820;
      --panel-2: #17212b;
      --tile: #1d2a35;
      --line: #4f7185;
      --line-soft: #31495a;
      --text: #e9ffcf;
      --muted: #9ec5ab;
      --cyan: #5efcff;
      --acid: #c8ff41;
      --pink: #ff5fb7;
      --orange: #ffb24a;
      --red: #ff5a52;
      --blue: #6bb7ff;
      --shadow: #050708;
      --pixel: 4px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        linear-gradient(90deg, rgba(94, 252, 255, 0.08) 1px, transparent 1px) 0 0 / 24px 24px,
        linear-gradient(0deg, rgba(200, 255, 65, 0.06) 1px, transparent 1px) 0 0 / 24px 24px,
        radial-gradient(circle at 82% 8%, rgba(255, 95, 183, 0.22), transparent 28%),
        radial-gradient(circle at 12% 92%, rgba(94, 252, 255, 0.16), transparent 30%),
        var(--ink);
      color: var(--text);
      font: 15px/1.55 "Courier New", "Lucida Console", monospace;
      letter-spacing: 0;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 20;
      pointer-events: none;
      background:
        repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 5px),
        linear-gradient(180deg, transparent, rgba(11, 15, 18, 0.28));
      mix-blend-mode: screen;
      opacity: 0.32;
      animation: scanline 7s linear infinite;
    }

    a {
      color: var(--cyan);
      text-decoration: none;
    }

    a:hover {
      color: var(--acid);
      text-shadow: 0 0 10px rgba(200, 255, 65, 0.7);
    }

    button,
    input,
    select {
      font: inherit;
    }

    .shell {
      width: min(1320px, calc(100% - 28px));
      margin: 0 auto;
      padding: 18px 0 40px;
    }

    .hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 16px;
      border: var(--pixel) solid var(--line);
      background: var(--panel);
      box-shadow:
        0 0 0 var(--pixel) var(--shadow),
        12px 12px 0 var(--shadow),
        inset 0 0 0 var(--pixel) rgba(255, 255, 255, 0.04);
      padding: 22px;
      overflow: hidden;
      animation: boot 560ms steps(5, end) both;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 8px;
      background: repeating-linear-gradient(90deg, var(--cyan) 0 24px, var(--acid) 24px 48px, var(--pink) 48px 72px, var(--orange) 72px 96px);
    }

    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--acid);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .kicker::before {
      content: "";
      width: 12px;
      height: 12px;
      background: var(--acid);
      box-shadow:
        16px 0 0 var(--cyan),
        32px 0 0 var(--pink);
    }

    h1 {
      max-width: 860px;
      margin: 13px 0 12px;
      color: #fff;
      font-size: clamp(32px, 6vw, 72px);
      line-height: 0.92;
      text-transform: uppercase;
      text-shadow:
        4px 0 0 rgba(255, 95, 183, 0.85),
        -4px 4px 0 rgba(94, 252, 255, 0.65),
        0 8px 0 var(--shadow);
      word-break: break-word;
    }

    .hero-copy {
      max-width: 880px;
      margin: 0;
      color: var(--muted);
    }

    .scoreboard {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      align-content: start;
    }

    .score {
      min-height: 92px;
      border: var(--pixel) solid var(--line-soft);
      background: #0d141a;
      padding: 12px;
      box-shadow: inset 0 0 0 var(--pixel) rgba(255, 255, 255, 0.03);
    }

    .score strong {
      display: block;
      color: var(--acid);
      font-size: 28px;
      line-height: 1;
    }

    .score span {
      display: block;
      margin-top: 8px;
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
    }

    .controls {
      display: grid;
      grid-template-columns: minmax(220px, 1fr) 190px 190px auto;
      gap: 10px;
      margin: 18px 0;
      border: var(--pixel) solid var(--line);
      background: var(--panel-2);
      box-shadow: 8px 8px 0 var(--shadow);
      padding: 12px;
    }

    .field {
      display: grid;
      gap: 6px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }

    input,
    select,
    .reset {
      width: 100%;
      min-height: 44px;
      border: var(--pixel) solid var(--line-soft);
      border-radius: 0;
      background: #090d10;
      color: var(--text);
      padding: 0 10px;
      outline: none;
    }

    input:focus,
    select:focus,
    .reset:focus {
      border-color: var(--acid);
      box-shadow: 0 0 0 var(--pixel) rgba(200, 255, 65, 0.18);
    }

    .reset {
      align-self: end;
      cursor: pointer;
      color: var(--ink);
      background: var(--acid);
      font-weight: 900;
      text-transform: uppercase;
      box-shadow: 4px 4px 0 var(--shadow);
    }

    .reset:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--shadow);
    }

    .ticker {
      display: flex;
      gap: 12px;
      align-items: center;
      min-height: 44px;
      margin: 0 0 16px;
      border: var(--pixel) solid var(--line-soft);
      background: #091014;
      overflow: hidden;
    }

    .ticker strong {
      align-self: stretch;
      display: inline-flex;
      align-items: center;
      padding: 0 12px;
      background: var(--pink);
      color: var(--ink);
      text-transform: uppercase;
    }

    .ticker-track {
      display: flex;
      gap: 24px;
      white-space: nowrap;
      animation: marquee 28s linear infinite;
    }

    .ticker-track span {
      color: var(--cyan);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 16px;
      align-items: start;
    }

    .finding {
      position: relative;
      min-height: 260px;
      border: var(--pixel) solid var(--line);
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.035) 0 25%, transparent 25% 50%, rgba(255, 255, 255, 0.035) 50% 75%, transparent 75%) 0 0 / 16px 16px,
        var(--tile);
      box-shadow: 8px 8px 0 var(--shadow);
      padding: 14px;
      animation: cardIn 420ms steps(4, end) both;
    }

    .finding:nth-child(4n + 1) { animation-delay: 60ms; }
    .finding:nth-child(4n + 2) { animation-delay: 120ms; }
    .finding:nth-child(4n + 3) { animation-delay: 180ms; }
    .finding:nth-child(4n + 4) { animation-delay: 240ms; }

    .finding.is-hidden {
      display: none;
    }

    .finding::before {
      content: attr(data-id);
      position: absolute;
      top: -4px;
      right: -4px;
      background: var(--cyan);
      color: var(--ink);
      padding: 6px 8px;
      font-weight: 900;
      box-shadow: -4px 4px 0 var(--shadow);
    }

    .finding-top {
      display: flex;
      align-items: start;
      gap: 10px;
      padding-right: 88px;
    }

    .severity {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 82px;
      min-height: 34px;
      border: var(--pixel) solid var(--shadow);
      color: var(--ink);
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      box-shadow: 4px 4px 0 var(--shadow);
    }

    .sev-error { background: var(--red); }
    .sev-warning { background: var(--orange); }
    .sev-note { background: var(--blue); }
    .sev-none { background: #9aa7b2; }
    .sev-unknown { background: var(--pink); }

    .finding h2 {
      margin: 0;
      color: #fff;
      font-size: 18px;
      line-height: 1.2;
      word-break: break-word;
    }

    .meta {
      display: grid;
      gap: 8px;
      margin: 14px 0;
      color: var(--muted);
      font-size: 12px;
    }

    .meta code {
      color: var(--acid);
    }

    .path {
      display: block;
      margin-top: 10px;
      color: var(--cyan);
      word-break: break-word;
    }

    details {
      margin-top: 12px;
      border-top: var(--pixel) solid var(--line-soft);
      padding-top: 10px;
    }

    summary {
      cursor: pointer;
      color: var(--acid);
      font-weight: 900;
      text-transform: uppercase;
    }

    pre {
      overflow: auto;
      border: var(--pixel) solid var(--line-soft);
      background: #070a0d;
      color: #d7ffe3;
      padding: 12px;
      white-space: pre-wrap;
    }

    .tiny-list {
      margin: 8px 0 0;
      padding-left: 22px;
      color: var(--muted);
    }

    .empty {
      display: none;
      border: var(--pixel) solid var(--pink);
      background: #1b1019;
      box-shadow: 8px 8px 0 var(--shadow);
      padding: 24px;
      color: var(--pink);
      font-weight: 900;
      text-transform: uppercase;
    }

    .empty.is-visible {
      display: block;
    }

    @keyframes boot {
      from {
        opacity: 0;
        transform: translateY(-12px) scaleY(0.9);
      }
      to {
        opacity: 1;
        transform: translateY(0) scaleY(1);
      }
    }

    @keyframes cardIn {
      from {
        opacity: 0;
        transform: translate(10px, 10px);
      }
      to {
        opacity: 1;
        transform: translate(0, 0);
      }
    }

    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @keyframes scanline {
      from { transform: translateY(-18px); }
      to { transform: translateY(18px); }
    }

    @media (max-width: 920px) {
      .hero,
      .controls {
        grid-template-columns: 1fr;
      }

      .scoreboard {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .shell {
        width: min(100% - 18px, 1320px);
      }

      .hero,
      .controls,
      .finding {
        box-shadow: 6px 6px 0 var(--shadow);
      }

      .scoreboard {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .finding-top {
        display: grid;
        padding-right: 70px;
      }
    }
  </style>
</head>
<body>
  <div class="shell">
    <header class="hero">
      <div>
        <div class="kicker">SARIF arcade cartridge // {{ .SchemaVersion }}</div>
        <h1>{{ .Title }}</h1>
        <p class="hero-copy">{{ .Report.Summary.Total }} findings loaded from {{ len .Report.Sources }} SARIF source file(s). Rendered {{ .GeneratedAt }}.</p>
      </div>
      <section class="scoreboard" aria-label="Severity counts">
        {{ range .Severities }}
        <div class="score">
          <strong>{{ .Count }}</strong>
          <span>{{ .Name }}</span>
        </div>
        {{ end }}
      </section>
    </header>

    <section class="controls" aria-label="Report controls">
      <label class="field">
        Search ROM
        <input id="search" type="search" placeholder="message, rule, file, tool">
      </label>
      <label class="field">
        Severity
        <select id="severity">
          <option value="">All severities</option>
          {{ range .Severities }}<option value="{{ .Name }}">{{ .Name }} ({{ .Count }})</option>{{ end }}
        </select>
      </label>
      <label class="field">
        Tool
        <select id="tool">
          <option value="">All tools</option>
          {{ range .ToolGroups }}<option value="{{ .Name }}">{{ .Name }} ({{ .Count }})</option>{{ end }}
        </select>
      </label>
      <button class="reset" id="reset" type="button">Reset</button>
    </section>

    <section class="ticker" aria-label="Report summary">
      <strong id="visible-count">{{ .Report.Summary.Total }} visible</strong>
      <div class="ticker-track" aria-hidden="true">
        {{ range .Rules }}<span>{{ .Name }}: {{ .Count }}</span>{{ end }}
        {{ range .Files }}<span>{{ .Name }}: {{ .Count }}</span>{{ end }}
        {{ range .Rules }}<span>{{ .Name }}: {{ .Count }}</span>{{ end }}
        {{ range .Files }}<span>{{ .Name }}: {{ .Count }}</span>{{ end }}
      </div>
    </section>

    <main>
      <div class="grid" id="findings">
        {{ range .Report.Findings }}
        <article class="finding" id="{{ .ID }}" data-id="{{ .ID }}" data-severity="{{ .Level }}" data-tool="{{ .Tool }}" data-search="{{ .ID }} {{ .Source }} {{ .Tool }} {{ .RuleID }} {{ .RuleName }} {{ .Path }} {{ .Message }}">
          <div class="finding-top">
            <span class="severity {{ severityClass .Level }}">{{ .Level }}</span>
            <h2>{{ .Message }}</h2>
          </div>

          <div class="meta">
            <div>RULE <code>{{ .RuleID }}</code>{{ if .RuleName }} // {{ .RuleName }}{{ end }}</div>
            <div>TOOL {{ .Tool }}{{ if .ToolVersion }} // {{ .ToolVersion }}{{ end }}</div>
            <div>SOURCE {{ .Source }}</div>
            <div>HASH <code>{{ .Fingerprint }}</code></div>
          </div>

          {{ if .SourceLink }}
          <a class="path" href="{{ .SourceLink }}">{{ .Path }}:{{ line .StartLine }}</a>
          {{ else }}
          <span class="path">{{ .Path }}:{{ line .StartLine }}</span>
          {{ end }}

          {{ if hasDetails . }}
          <details>
            <summary>Open evidence bay</summary>
            {{ if .RuleDescription }}<p>{{ .RuleDescription }}</p>{{ end }}
            {{ if .RuleHelpURI }}<p><a href="{{ .RuleHelpURI }}">{{ .RuleHelpURI }}</a></p>{{ end }}
            {{ if .Snippet }}<pre><code>{{ .Snippet }}</code></pre>{{ end }}
            {{ if .RelatedLocations }}
            <ol class="tiny-list">
              {{ range .RelatedLocations }}<li>{{ .Path }}:{{ line .StartLine }} {{ .Message }}</li>{{ end }}
            </ol>
            {{ end }}
            {{ if .CodeFlows }}
            {{ range .CodeFlows }}
            <ol class="tiny-list">
              {{ range .Locations }}<li>{{ .Path }}:{{ line .StartLine }} {{ .Message }}</li>{{ end }}
            </ol>
            {{ end }}
            {{ end }}
          </details>
          {{ end }}
        </article>
        {{ end }}
      </div>
      <div class="empty" id="empty">No matching cartridges found.</div>
    </main>
  </div>

  <script>
    (function () {
      const search = document.getElementById("search");
      const severity = document.getElementById("severity");
      const tool = document.getElementById("tool");
      const reset = document.getElementById("reset");
      const cards = Array.from(document.querySelectorAll(".finding"));
      const count = document.getElementById("visible-count");
      const empty = document.getElementById("empty");

      function normalize(value) {
        return String(value || "").trim().toLowerCase();
      }

      function applyFilters() {
        const query = normalize(search.value);
        const selectedSeverity = normalize(severity.value);
        const selectedTool = normalize(tool.value);
        let visible = 0;

        cards.forEach((card) => {
          const matchesQuery = !query || normalize(card.dataset.search).includes(query);
          const matchesSeverity = !selectedSeverity || normalize(card.dataset.severity) === selectedSeverity;
          const matchesTool = !selectedTool || normalize(card.dataset.tool) === selectedTool;
          const show = matchesQuery && matchesSeverity && matchesTool;
          card.classList.toggle("is-hidden", !show);
          if (show) visible += 1;
        });

        count.textContent = visible + " visible";
        empty.classList.toggle("is-visible", visible === 0);
      }

      [search, severity, tool].forEach((control) => {
        control.addEventListener("input", applyFilters);
        control.addEventListener("change", applyFilters);
      });

      reset.addEventListener("click", () => {
        search.value = "";
        severity.value = "";
        tool.value = "";
        applyFilters();
        search.focus();
      });

      applyFilters();
    })();
  </script>
</body>
</html>
